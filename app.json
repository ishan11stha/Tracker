{
  "expo": {
    "name": "VAULT",
    "slug": "vault-personal-tracker",
    "scheme": "vault",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "android"
    ],
    "android": {
      "package": "com.vault.lifetracker",
      "versionCode": 3,
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.CAMERA"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#0F172A"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "VAULT accesses your photos so you can attach images to your tracked personal items.",
          "cameraPermission": "VAULT uses your camera so you can photograph personal items for your inventory.",
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a"
            ],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enablePngCrunchInReleaseBuilds": true,
            "useLegacyPackaging": true,
            "enableBundleCompression": true,
            "gifEnabled": false,
            "webpAnimated": false,
            "networkInspector": false,
            "usesCleartextTraffic": false
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8FAFC",
          "dark": {
            "backgroundColor": "#0B0F19"
          }
        }
      ],
      "expo-speech-recognition"
    ],
    "extra": {
      "eas": {
        "projectId": "1605a62a-85ea-4abd-aae4-e16132954a4b"
      }
    }
  }
}
